---
const projects = [
  {
    title: "Project One",
    description: "Deskripsi singkat project pertama kamu.",
    tech: ["Astro", "Tailwind", "TypeScript"],
    github: "https://github.com/username/project-one",
    live: "https://project-one.vercel.app",
  },
  {
    title: "Project Two",
    description: "Deskripsi singkat project kedua kamu.",
    tech: ["React", "Node.js", "PostgreSQL"],
    github: "https://github.com/username/project-two",
    live: "",
  },
  {
    title: "Project Three",
    description: "Deskripsi singkat project ketiga kamu.",
    tech: ["Python", "FastAPI", "Docker"],
    github: "https://github.com/username/project-three",
    live: "https://project-three.vercel.app",
  },
];
---

<section id="projects" class="py-24 px-6">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-text-muted text-sm tracking-widest uppercase mb-12">
      <span class="text-accent">~</span>/projects
    </h2>

    <div class="space-y-6">
      {projects.map((project, index) => (
        <div class="group p-6 rounded-lg border border-bg-secondary hover:border-text-muted transition-all duration-300 bg-bg-secondary/50 hover:bg-bg-secondary">
          <div class="flex items-start justify-between mb-3">
            <div>
              <span class="text-text-muted text-xs">0{index + 1}.</span>
              <h3 class="text-text text-lg font-semibold group-hover:text-accent transition-colors">
                {project.title}
              </h3>
            </div>

            <div class="flex items-center gap-3">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener"
                  class="text-text-muted hover:text-text transition-colors text-sm"
                >
                  github ↗
                </a>
              )}
              {project.live && (
                <a
                  href={project.live}
                  target="_blank"
                  rel="noopener"
                  class="text-text-muted hover:text-accent transition-colors text-sm"
                >
                  live ↗
                </a>
              )}
            </div>
          </div>

          <p class="text-text-muted text-sm mb-4">{project.description}</p>

          <div class="flex flex-wrap gap-2">
            {project.tech.map((t) => (
              <span class="text-accent text-xs">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
