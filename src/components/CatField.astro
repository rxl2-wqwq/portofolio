---
const cats = [
  { src: "/cats/cat1.png", w: 308, h: 370 },
  { src: "/cats/cat2.png", w: 275, h: 344 },
  { src: "/cats/cat3.png", w: 302, h: 342 },
  { src: "/cats/cats1.png", w: 290, h: 355 },
  { src: "/cats/cats2.png", w: 288, h: 345 },
  { src: "/cats/cats3.png", w: 333, h: 359 },
  { src: "/cats/catA.png", w: 288, h: 345 },
];
---

<div class="cat-field" aria-hidden="true">
  {cats.map((cat) => (
    <div class="cat">
      <img src={cat.src} width={cat.w} height={cat.h} alt="" class="cat__img" />
    </div>
  ))}
</div>

<style>
  .cat-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .cat {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(64px, 8vw, 120px);
    opacity: 0;
    transition: opacity 800ms ease; /* samakan dengan FADE_MS di script */
    will-change: transform, opacity;
  }

  .cat__img {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    transform-origin: center;
    animation: cat-spin 9s linear infinite;
  }

  @keyframes cat-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 1023px) {
    .cat-field {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cat__img {
      animation: none;
    }
    .cat {
      transition: none;
    }
  }
</style>

<script>
  const FADE_MS = 800;
  const CONTENT_W = 48 * 16;

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const rand = (min: number, max: number): number =>
    min + Math.random() * (max - min);

  interface Cat {
    el: HTMLElement;
    x: number;
    y: number;
    vx: number;
    vy: number;
    w: number;
    h: number;
    zone: number;
    state: string;
    timer: ReturnType<typeof setTimeout>;
  }

  const field = document.querySelector<HTMLElement>(".cat-field");

  const cats: Cat[] = field
    ? Array.from(field.querySelectorAll<HTMLElement>(".cat")).map((el) => ({
        el,
        x: 0,
        y: 0,
        vx: 0,
        vy: 0,
        w: 0,
        h: 0,
        zone: 0,
        state: "active",
        timer: setTimeout(() => {}, 0),
      }))
    : [];

  let fieldW = 0;
  let fieldH = 0;
  let margin = 0;

  function zoneBounds(c: Cat) {
    const minX = c.zone === 0 ? 0 : fieldW - margin;
    const maxX = c.zone === 0 ? margin : fieldW;
    return { minX, maxX };
  }

  function paint(c: Cat) {
    c.el.style.transform = `translate3d(${c.x}px, ${c.y}px, 0)`;
  }

  // Check if a position overlaps with existing placed cats
  function overlapsOthers(
    c: Cat,
    cx: number,
    cy: number,
    placed: Cat[],
  ): boolean {
    const aR = (c.w + c.h) / 4;
    for (const other of placed) {
      const bR = (other.w + other.h) / 4;
      const dx = cx + c.w / 2 - (other.x + other.w / 2);
      const dy = cy + c.h / 2 - (other.y + other.h / 2);
      const dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < aR + bR + 10) return true; // +10px padding
    }
    return false;
  }

  function place(c: Cat, placed: Cat[] = []) {
    const { minX, maxX } = zoneBounds(c);
    const maxXPos = Math.max(minX, maxX - c.w);
    const maxYPos = Math.max(0, fieldH - c.h);

    const pad = 12;
    const loX = Math.min(minX + pad, maxXPos);
    const hiX = Math.max(loX, maxXPos - pad);
    const loY = Math.min(pad, maxYPos);
    const hiY = Math.max(loY, maxYPos - pad);

    // Try up to 20 times to find a non-overlapping position
    let attempts = 0;
    do {
      c.x = rand(loX, hiX);
      c.y = rand(loY, hiY);
      attempts++;
    } while (overlapsOthers(c, c.x, c.y, placed) && attempts < 20);

    const center = (minX + maxX) / 2;
    const towardCenter = c.x + c.w / 2 < center ? 1 : -1;
    const speed = rand(0.3, 0.8);
    const angle = rand(0.15, 0.85) * Math.PI;

    c.vx = Math.cos(angle) * speed * towardCenter;
    c.vy = (Math.random() < 0.5 ? -1 : 1) * Math.sin(angle) * speed;

    paint(c);
  }

  function measure() {
    if (!field) return;

    fieldW = field.clientWidth;
    fieldH = field.clientHeight;
    margin = Math.max(0, (fieldW - CONTENT_W) / 2);

    for (const c of cats) {
      c.w = c.el.offsetWidth;
      c.h = c.el.offsetHeight;

      if (c.state === "active") {
        const { minX, maxX } = zoneBounds(c);
        c.x = Math.min(Math.max(c.x, minX), Math.max(minX, maxX - c.w));
        c.y = Math.min(Math.max(c.y, 0), Math.max(0, fieldH - c.h));
        paint(c);
      }
    }
  }
  function keepInside(c: Cat) {
    const { minX, maxX } = zoneBounds(c);
    const maxXPos = Math.max(minX, maxX - c.w);
    const maxYPos = Math.max(0, fieldH - c.h);

    if (c.x < minX) {
      c.x = minX;
      c.vx = Math.abs(c.vx);
    } else if (c.x > maxXPos) {
      c.x = maxXPos;
      c.vx = -Math.abs(c.vx);
    }

    if (c.y < 0) {
      c.y = 0;
      c.vy = Math.abs(c.vy);
    } else if (c.y > maxYPos) {
      c.y = maxYPos;
      c.vy = -Math.abs(c.vy);
    }
  }

  function startFadeOut(c: Cat) {
    if (c.state !== "active") return;

    c.state = "out";
    c.el.style.opacity = "0";

    clearTimeout(c.timer);
    c.timer = setTimeout(() => {
      c.zone = Math.random() < 0.5 ? 0 : 1;
      const activeCats = cats.filter((o) => o !== c && o.state === "active");
      place(c, activeCats);

      c.state = "in";
      c.el.style.opacity = "1";

      c.timer = setTimeout(() => {
        c.state = "active";
      }, FADE_MS);
    }, FADE_MS);
  }

  function checkCollisions() {
    for (let i = 0; i < cats.length; i++) {
      const a = cats[i];
      if (a.state !== "active") continue;

      for (let j = i + 1; j < cats.length; j++) {
        const b = cats[j];
        if (b.state !== "active") continue;

        const aCx = a.x + a.w / 2;
        const aCy = a.y + a.h / 2;
        const bCx = b.x + b.w / 2;
        const bCy = b.y + b.h / 2;

        const dx = bCx - aCx;
        const dy = bCy - aCy;

        const aR = (a.w + a.h) / 4;
        const bR = (b.w + b.h) / 4;
        const minDist = aR + bR;

        const distSq = dx * dx + dy * dy;

        if (distSq < minDist * minDist && distSq > 0) {
          const dist = Math.sqrt(distSq);
          const nx = dx / dist;
          const ny = dy / dist;

          const dvx = a.vx - b.vx;
          const dvy = a.vy - b.vy;
          const dvn = dvx * nx + dvy * ny;

          if (dvn > 0) {
            a.vx -= dvn * nx;
            a.vy -= dvn * ny;
            b.vx += dvn * nx;
            b.vy += dvn * ny;
          }

          // Push apart firmly to prevent sticking
          const overlap = minDist - dist;
          const sep = overlap / 2 + 2;
          a.x -= sep * nx;
          a.y -= sep * ny;
          b.x += sep * nx;
          b.y += sep * ny;
          keepInside(a);
          keepInside(b);
        }
      }
    }
  }

  function step(dt: number) {
    if (fieldW <= 0 || fieldH <= 0) return;

    for (const c of cats) {
      if (c.state !== "active") continue;

      c.x += c.vx * dt;
      c.y += c.vy * dt;

      const { minX, maxX } = zoneBounds(c);
      const maxXPos = Math.max(minX, maxX - c.w);
      const maxYPos = Math.max(0, fieldH - c.h);

      let hit = false;

      if (c.x < minX) {
        c.x = minX;
        hit = true;
      } else if (c.x > maxXPos) {
        c.x = maxXPos;
        hit = true;
      }

      if (c.y < 0) {
        c.y = 0;
        hit = true;
      } else if (c.y > maxYPos) {
        c.y = maxYPos;
        hit = true;
      }

      if (hit) startFadeOut(c);
    }

    checkCollisions();

    for (const c of cats) {
      if (c.state === "active") paint(c);
    }
  }

  if (field) {
    measure();

    const placed: Cat[] = [];
    for (const c of cats) {
      c.zone = Math.random() < 0.5 ? 0 : 1;
      place(c, placed);
      placed.push(c);
      c.el.style.opacity = "1";
      c.state = "active";
    }

    if (!reduceMotion) {
      let last = performance.now();

      const loop = (now: number) => {
        const dt = Math.min(now - last, 50) / 16.667;
        last = now;
        step(dt);
        requestAnimationFrame(loop);
      };

      requestAnimationFrame(loop);
    }

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(measure, 150);
    });

    window.addEventListener("load", measure);
  }
</script>
