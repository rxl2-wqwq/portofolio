---
const socials = [
  { name: "github", url: "https://github.com/rxl2-wqwq" },
  {
    name: "linkedin",
    url: "https://www.linkedin.com/in/rizal-arief-zuhdi-34307a328/",
  },
  { name: "email", url: "mailto:ariefzuhdirjob@gmail.com" },
];
---

<section id="contact" class="py-24 px-6 bg-bg-secondary">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-text-muted text-sm tracking-widest mb-8">
      <span class="text-accent">~</span>/rzal/contact
    </h2>

    <p class="text-text text-2xl md:text-3xl font-bold mb-4">
      let's work together<span class="text-accent">.</span>
    </p>

    <p class="text-text-muted text-sm mb-10 max-w-md mx-auto leading-relaxed">
      Got a project in mind? Or just want to say hi? Feel free to reach out —
      I'm always open to new opportunities.
    </p>

    <div class="flex items-center justify-center gap-6">
      {socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener"
          class="px-4 py-2 border border-text-muted text-text-muted text-sm rounded hover:border-accent hover:text-accent transition-colors"
        >
          {social.name}
        </a>
      ))}
    </div>
  </div>
</section>
